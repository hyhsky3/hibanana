# Banana AI 环境变量配置
# 复制此文件为 .env.local 并填入真实的 API Key

# GRSAI API Key (必填) - 用于调用 Nano Banana Pro 图像生成模型
# 获取方式: 联系 GRSAI 服务提供商
VITE_GRSAI_API_KEY=your_grsai_api_key_here

# GRSAI API Base URL (可选) - 默认为国内直连节点
VITE_GRSAI_API_BASE_URL=https://grsai.dakka.com.cn

# GRSAI Model Name (可选) - 默认为 nano-banana-2.1
VITE_GRSAI_MODEL_NAME=nano-banana-2.1


